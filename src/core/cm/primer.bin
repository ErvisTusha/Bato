#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX_LINE 1024

typedef struct node {
    int value;
    struct node *next;
} node_t;

static node_t *push(node_t *head, int value)
{
    node_t *n = malloc(sizeof(node_t));
    if (n == NULL) {
        fprintf(stderr, "out of memory\n");
        exit(1);
    }
    n->value = value;
    n->next = head;
    return n;
}

int main(int argc, char **argv)
{
    char line[MAX_LINE];
    node_t *head = NULL;
    int i, total = 0;

    for (i = 1; i < argc; i++) {
        head = push(head, atoi(argv[i]));
    }
    while (fgets(line, sizeof(line), stdin) != NULL) {
        if (strlen(line) > 1) {
            head = push(head, atoi(line));
        }
    }
    for (node_t *p = head; p != NULL; p = p->next) {
        total += p->value;
    }
    printf("total = %d\n", total);
    return 0;
}

import os
import sys
import json
import argparse


class Counter:
    """Counts words in text files."""

    def __init__(self, path):
        self.path = path
        self.counts = {}

    def run(self):
        with open(self.path, "r", encoding="utf-8") as handle:
            for line in handle:
                for word in line.lower().split():
                    self.counts[word] = self.counts.get(word, 0) + 1
        return self.counts


def main(argv=None):
    parser = argparse.ArgumentParser(description="count words")
    parser.add_argument("files", nargs="+")
    parser.add_argument("--top", type=int, default=10)
    args = parser.parse_args(argv)
    for name in args.files:
        if not os.path.isfile(name):
            print("not a file: %s" % name, file=sys.stderr)
            continue
        counts = Counter(name).run()
        best = sorted(counts.items(), key=lambda item: -item[1])[: args.top]
        print(json.dumps({"file": name, "top": best}, indent=2))


if __name__ == "__main__":
    main()

function debounce(callback, delay) {
  let timer = null;
  return function (...args) {
    clearTimeout(timer);
    timer = setTimeout(() => callback.apply(this, args), delay);
  };
}

