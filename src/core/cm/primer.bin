namespace shapes {

class Shape {
public:
    virtual ~Shape() = default;
    virtual double area() const = 0;
    virtual std::string name() const { return "shape"; }
};

class Circle : public Shape {
public:
    explicit Circle(double radius) : radius_(radius) {}
    double area() const override { return 3.14159265358979 * radius_ * radius_; }
    std::string name() const override { return "circle"; }
private:
    double radius_;
};

}  // namespace shapes

int main(int argc, char *argv[]) {
    std::vector<std::string> words;
    std::map<std::string, int> counts;
    for (int i = 1; i < argc; ++i) {
        words.push_back(argv[i]);
        ++counts[argv[i]];
    }
    std::sort(words.begin(), words.end());
    for (const auto &entry : counts) {
        std::cout << entry.first << ": " << entry.second << std::endl;
    }
    return 0;
}

use std::collections::HashMap;
use std::fs::File;
use std::io::{self, BufRead, BufReader};

#[derive(Debug, Clone, PartialEq)]
pub enum Token {
    Number(f64),
    Word(String),
    Symbol(char),
}

pub fn tokenize(line: &str) -> Vec<Token> {
    let mut tokens = Vec::new();
    for part in line.split_whitespace() {
        if let Ok(value) = part.parse::<f64>() {
            tokens.push(Token::Number(value));
        } else if part.chars().all(|c| c.is_alphanumeric()) {
            tokens.push(Token::Word(part.to_string()));
        } else {
            tokens.extend(part.chars().map(Token::Symbol));
        }
    }
    tokens
}

fn main() -> io::Result<()> {
    let file = File::open("input.txt")?;
    let mut counts: HashMap<String, usize> = HashMap::new();
    for line in BufReader::new(file).lines() {
        for token in tokenize(&line?) {
            if let Token::Word(word) = token {
                *counts.entry(word).or_insert(0) += 1;
            }
        }
    }
    println!("{} distinct words", counts.len());
    Ok(())
}

interface User {
  id: number;
  name: string;
  email?: string;
}

export async function fetchUsers(url: string): Promise<User[]> {
  const response = await fetch(url);
  if (!response.ok) {
    throw new Error(`Request failed: ${response.status}`);
  }
  const data = (await response.json()) as User[];
  return data.filter((user) => user.name.length > 0);
}

