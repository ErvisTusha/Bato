#!/usr/bin/perl
use strict;
use warnings;
my %seen;
while (my $line = <STDIN>) {
    chomp $line;
    next if $line =~ /^\s*(#|$)/;
    my ($key, $value) = split /=/, $line, 2;
    $seen{$key}++;
    print "$key => $value\n";
}
print scalar(keys %seen), " keys\n";

