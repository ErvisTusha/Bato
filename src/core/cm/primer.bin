class Account
  attr_reader :balance

  def initialize(balance = 0)
    @balance = balance
  end

  def deposit(amount)
    raise ArgumentError, "amount must be positive" unless amount.positive?
    @balance += amount
  end
end

account = Account.new(100)
account.deposit(50)
puts "Balance: #{account.balance}"

