mkdir -p "$DEST" || exit 1
rsync -a --delete --exclude='.cache' "$SRC/" "$DEST/"
if [ $? -ne 0 ]; then
    echo "backup failed" >&2
    exit 1
fi
echo "backup finished: $DEST"

