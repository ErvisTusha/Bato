SELECT customers.name, orders.total, orders.created_at
FROM customers
JOIN orders ON orders.customer_id = customers.id
WHERE orders.total > 100 AND orders.status = 'paid'
GROUP BY customers.name
ORDER BY orders.total DESC
LIMIT 20;

CREATE TABLE users (
  id INTEGER PRIMARY KEY,
  name TEXT NOT NULL,
  email TEXT UNIQUE,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

#!/bin/sh
set -e
for file in *.txt; do
  if [ -f "$file" ]; then
    echo "processing $file"
    gzip -9 -c "$file" > "$file.gz"
  fi
done
echo "done"

package main

import (
	"fmt"
	"os"
	"strings"
)

type Server struct {
	Name string
	Port int
}

func (s *Server) String() string {
	return fmt.Sprintf("%s:%d", s.Name, s.Port)
}

func main() {
	servers := []*Server{{"alpha", 8080}, {"beta", 9090}}
	for i, s := range servers {
		fmt.Println(i, s, strings.ToUpper(s.Name))
	}
	if len(os.Args) > 1 {
		os.Exit(1)
	}
}

public class Greeter {
    private final String name;

    public Greeter(String name) {
        this.name = name;
    }

    public String greet() {
        return "Hello, " + name + "!";
    }

    public static void main(String[] args) {
        for (String arg : args) {
            System.out.println(new Greeter(arg).greet());
        }
    }
}

(defun factorial (n)
  "Return the factorial of N."
  (if (<= n 1)
      1
    (* n (factorial (- n 1)))))

(defun map-list (function items)
  (cond ((null items) nil)
        (t (cons (funcall function (car items))
                 (map-list function (cdr items))))))

