Erkennest dann der Sterne Lauf,
Und wenn Natur dich Unterweist,
Dann geht die Seelenkraft dir auf,
Wie spricht ein Geist zum andren Geist.
Umsonst, da√ü trocknes Sinnen hier
Die heil‚Äôgen Zeichen dir erkl√§rt.
Ihr schwebt, ihr Geister, neben mir;
Antwortet mir, wenn ihr mich h√∂rt!
(Er schl√§gt das Buch auf und erblickt das Zeichen des Makrokosmus.)

Ha! welche Wonne flie√üt in diesem Blick
Auf einmal mir durch alle meine Sinnen!
Ich f√ºhle junges, heil‚Äôges Lebensgl√ºck
Neugl√ºhend mir durch Nerv‚Äô und Adern rinnen.
War es ein G//! Original bounded fixed-point online LSTM byte expert, without peepholes.
//! Provenance: LSTM gate equations described by Hochreiter/Schmidhuber (1997),
//! Gers et al. (2000), and Greff et al., arXiv:1503.04069, section II. All
//! quantization, initialization, byte-tree readout and Rust here are original;
//! no compressor implementation, learned weights or model tables are copied.

use super::super::{
    logistic,
    simd::{self, Dispatch},
};
use crate::core::{memory::try_filled, types::BatoError};

const WIDTH: usize = 32;
const GATES: usize = 4;
const ROWS: usize = WIDTH * GATES;
/// Embedding rows: one per byte value plus `NO_BYTE`.
const SYMBOLS: usize = 257;
/// Embedding row used before the first byte of a segment.
const NO_BYTE: usize = 256;
const RECURRENT: usize = SYMBOLS * ROWS;
const BIAS: usize = RECURRENT + ROWS * WIDTH;
const HEAD: usize = BIAS + ROWS;
/// One readout row (WIDTH weights and a bias) per partial-byte node.
const WEIGHTS: usize = HEAD + 255 * (WIDTH + 1);
/// Fractional bits of activations, gates and cells.
const FRACTION_BITS: u32 = simd::NEURAL_FRACTION_BITS as u32;
/// Activation, gate and cell value 1.0.
const ONE: i32 = 1 << FRACTION_BITS;
/// Fractional bits of weights, gate pre-activations and the bit target.
const WEIGHT_BITS: u32 = 16;
/// Weight and probability value 1.0.
const WEIGHT_ONE: i32 = 1 << WEIGHT_BITS;
/// Fractional bits of the shared logistic table's logit unit (1/256).
const LOGIT_BITS: u32 = 8;
const CELL_LIMIT: i32 = 4 * ONE;
/// Clip of hidden and cell gradients during backpropagation.
const HIDDEN_GRADIENT_LIMIT: i32 = 4 * ONE;
/// Clip of each gate's pre-activation gradient.
const GATE_GRADIENT_LIMIT: i32 = 2 * ONE;
const WEIGHT_LIMIT: i32 = simd::NEURAL_WEIGHT_LIMIT;
const HEAD_LIMIT: i32 = 16 * WEIGHT_ONE;
/// Learning-rate shift (rate 1/32) of the embedding, bias and readout.
const UPDATE_SHIFT: u32 = simd::NEURAL_UPDATE_SHIFT as u32;
/// Shift of the readout error times a readout weight, giving a hidden
/// gradient with `FRACTION_BITS`.
const HEAD_GRADIENT_SHIFT: u32 = 2 * WEIGHT_BITS - FRACTION_BITS;
/// Initialization ranges: embedding ¬±0.25, recurrent ¬±1/16, readout ¬±1/256.
const EMBEDDING_INIT: i32 = WEIGHT_ONE / 4;
const RECURRENT_INIT: i32 = WEIGHT_ONE / 16;
const HEAD_INIT: i32 = WEIGHT_ONE / 256;
/// Initial input-gate bias: -1.0 keeps new information out at first.
const INPUT_GATE_BIAS: i32 = -WEIGHT_ONE;
/// Forget-gate biases cycle through 1.0..=4.0, a range of memory timescales.
const FORGET_TIMESCALES: i32 = 4;
/// Seed of the deterministic weight initialization.
const INIT_SEED: u64 = 0xc71e_549b_2a63_f805;
const STEPS: usize = 4;

#[derive(Clone, Copy, Default)]
struct Trace {
    input: usize,
    previous_hidden: [i32; WIDTH],
    previous_cell: [i32; WIDTH],
    gates: [[i32; WIDTH]; GATES],
    cell_tanh: [i32; WIDTH],
    cell_clipped: [bool; WIDTH],
}

// Q16 weights, Q15 activations and i64 intermediate products. The largest
// readout sum is 33 * 2^20 * 2^15 < 2^41; recurrent sums are smaller. Every
// gradient is clipped before updating bounded weights. No float conversion.
pub(in crate::core::cm) struct Lstm {
    weights: Vec<i32>,
    hidden: [i32; WIDTH],
    cell: [i32; WIDTH],
    previous_hidden: [i32; WIDTH],
    previous_cell: [i32; WIDTH],
    gates: [[i32; WIDTH]; GATES],
    cell_tanh: [i32; WIDTH],
    cell_clipped: [bool; WIDTH],
    gradient_hidden: [i32; WIDTH],
    input: usize,
    selected: usize,
    prediction: u16,
    observed_bits: u8,
    traces: [Trace; STEPS],
    trace_position: usize,
    trace_count: usize,
    dispatch: Dispatch,
}

#[inline]
fn round(value: i64, shift: u32) -> i32 {
    let half = 1i64 << (shift - 1);
    let sign = value >> 63;
    let magnitude = (value ^ sign) - sign;
    let rounded = (magnitude + half) >> shift;
    ((rounded ^ sign) - sign) as i32
}

#[inline]
fn product(a: i32, b: i32) -> i32 {
    round(i64::from(a) * i64::from(b), FRACTION_BITS)
}

#[inline]
fn squash(logit: i32) -> i32 {
    // Q16 logit, interpolated from the common 1/256-unit sigmoid table.
    // Reflect the positive half to preserve exact zero/one symmetry.
    const SUBSTEP_BITS: u32 = WEIGHT_BITS - LOGIT_BITS;
    const SUBSTEPS: i32 = 1 << SUBSTEP_BITS;
    let bound = logistic::LIMIT << SUBSTEP_BITS;
    let value = logit.clamp(-bound, bound);
    let magnitude = value.unsigned_abs();
    let base = (magnitude >> SUBSTEP_BITS) as i32;
    let fraction = (magnitude % SUBSTEPS as u32) as i32;
    let lower = i32::from(logistic::squash(base));
    let upper = i32::from(logistic::squash(base + 1));
    let probability = lower + ((upper - lower) * fraction + SUBSTEPS / 2) / SUBSTEPS;
    if value < 0 {
        WEIGHT_ONE - probability
    } else {
        probability
    }
}

#[inline]
fn tanh(logit: i32) -> i32 {
    squash(logit.saturating_mul(2)) - ONE
}

fn initialize(index: usize, limit: i32) -> i32 {
    let value = super::super::hash::mix((index as u64).wrapping_add(INIT_SEED));
    (value % (2 * limit + 1) as u64) as i32 - limit
}

impl Lstm {
    pub(in crate::core::cm) fn memory_required() -> usize {
        WEIGHTS * std::mem::size_of::<i32>()
    }

    pub(in crate::core::cm) fn new(dispatch: Dispatch) -> Result<Self, BatoError> {
        let mut weights = try_filled(WEIGHTS, 0)?;
        for (index, weight) in weights.iter_mut().enumerate() {
            *weight = if index < RECURRENT {
                initialize(index, EMBEDDING_INIT)
            } else if index < BIAS {
                initialize(index, RECURRENT_INIT)
            } else if index < HEAD {
                0
            } else {
                initialize(index, HEAD_INIT)
            };
        }
        for unit in 0..WIDTH {
            weights[BIAS + WIDTH + unit] = INPUT_GATE_BIAS;
            // A deterministic range of memory timescales, independent of data.
            weights[BIAS + 2 * WIDTH + unit] = (1 + unit as i32 % FORGET_TIMESCALES) * WEIGHT_ONE;
        }
        Ok(Self {
            weights,
            hidden: [0; WIDTH],
            cell: [0; WIDTH],
            previous_hidden: [0; WIDTH],
            previous_cell: [0; WIDTH],
            gates: [[0; WIDTH]; GATES],
            cell_tanh: [0; WIDTH],
            cell_clipped: [false; WIDTH],
            gradient_hidden: [0; WIDTH],
            input: NO_BYTE,
            selected: 0,
            prediction: logistic::HALF,
            observed_bits: 0,
            traces: [Trace::default(); STEPS],
            trace_position: 0,
            trace_count: 0,
            dispatch,
        })
    }

    /// Runs the expert over a complete, already known byte sequence with the
    /// exact call order the predictor uses, sending one feature per bit in
    /// blocks of `block` bytes. Stops early if the receiver is dropped.
    pub(in crate::core::cm) fn stream_features(
        mut self,
        raw: &[u8],
        block: usize,
        sender: std::sync::mpsc::SyncSender<Vec<i16>>,
        recycled: std::sync::mpsc::Receiver<Vec<i16>>,
    ) {
        let mut position = 0usize;
        for bytes in raw.chunks(block) {
            let mut features = match recycled.try_recv() {
                Ok(mut storage) => {
                    storage.clear();
                    storage
                }
                Err(_) => Vec::with_capacity(bytes.len() * 8),
            };
            for &byte in bytes {
                self.begin_byte(position.checked_sub(1).map(|at| raw[at]));
                let mut prefix = 1u16;
                for shift in (0..8).rev() {
                    features.push(self.feature(prefix));
                    let bit = (byte >> shift) & 1;
                    self.observe(bit);
                    prefix = (prefix << 1) | u16::from(bit);
                }
                self.finish_byte();
                position += 1;
            }
            if sender.send(features).is_err() {
                return;
            }
        }
    }

    pub(in crate::core::cm) fn begin_byte(&mut self, previous: Option<u8>) {
        self.input = previous.map_or(NO_BYTE, usize::from);
        self.previous_hidden = self.hidden;
        self.previous_cell = self.cell;
        self.gradient_hidden.fill(0);
        self.observed_bits = 0;
        let sums = simd::recurrent_dots::<WIDTH, ROWS>(
            &self.weights[RECURRENT..BIAS],
            &self.previous_hidden,
            self.dispatch,
        );
        for (row, sum) in sums.into_iter().enumerate() {
            let activation = round(
                ((i64::from(self.weights[self.input * ROWS + row])
                    + i64::from(self.weights[BIAS + row]))
                    << FRACTION_BITS)
                    + sum,
                FRACTION_BITS,
            );
            self.gates[row / WIDTH][row % WIDTH] = if row < WIDTH {
                tanh(activation)
            } else {
                squash(activation) >> (WEIGHT_BITS - FRACTION_BITS)
            };
        }
        for unit in 0..WIDTH {
            let state = product(self.gates[2][unit], self.previous_cell[unit])
                + product(self.gates[1][unit], self.gates[0][unit]);
            self.cell[unit] = state.clamp(-CELL_LIMIT, CELL_LIMIT);
            self.cell_clipped[unit] = state != self.cell[unit];
            self.cell_tanh[unit] = tanh(self.cell[unit] * 2);
            self.hidden[unit] = product(self.gates[3][unit], self.cell_tanh[unit]);
        }
        self.traces[self.trace_position] = Trace {
            input: self.input,
            previous_hidden: self.previous_hidden,
            previous_cell: self.previous_cell,
            gates: self.gates,
            cell_tanh: self.cell_tanh,
            cell_clipped: self.cell_clipped,
        };
        self.trace_position = (self.trace_position + 1) % STEPS;
        self.trace_count = (self.trace_count + 1).min(STEPS);
    }

    #[inline]
    pub(in crate::core::cm) fn feature(&mut self, prefix: u16) -> i16 {
        debug_assert!((1..256).contains(&prefix));
        self.selected = usize::from(prefix - 1);
        let start = HEAD + self.selected * (WIDTH + 1);
        let mut sum = i64::from(self.weights[start + WIDTH]) << FRACTION_BITS;
        #[cfg(target_arch = "x86_64")]
        if self.dispatch.avx2() {
            // SAFETY: AVX2 detected; start is the selected 33-element row.
            sum += unsafe { self.head_dot_avx2(start) };
        } else {
            sum += self.head_dot_scalar(start);
        }
        #[cfg(not(target_arch = "x86_64"))]
        {
            sum += self.head_dot_scalar(start);
        }
        let logit = round(sum, WEIGHT_BITS + FRACTION_BITS - LOGIT_BITS)
            .clamp(-logistic::LIMIT, logistic::LIMIT);
        self.prediction = logistic::squash(logit);
        logit as i16
    }

    #[inline]
    pub(in crate::core::cm) fn observe(&mut self, bit: u8) {
        let error = if bit == 0 { WEIGHT_ONE } else { 0 } - i32::from(self.prediction);
        let start = HEAD + self.selected * (WIDTH + 1);
        #[cfg(target_arch = "x86_64")]
        if self.dispatch.avx2() {
            // SAFETY: AVX2 detected; all fixed-width arrays are initialized.
            unsafe { self.observe_head_avx2(start, error) };
        } else {
            self.observe_head_scalar(start, error);
        }
        #[cfg(not(target_arch = "x86_64"))]
        {
            self.observe_head_scalar(start, error);
        }
        self.weights[start + WIDTH] = (self.weights[start + WIDTH]
            + round(i64::from(error), UPDATE_SHIFT))
        .clamp(-HEAD_LIMIT, HEAD_LIMIT);
        self.observed_bits += 1;
    }

    fn head_dot_scalar(&self, start: usize) -> i64 {
        (0..WIDTH)
            .map(|unit| i64::from(self.weights[start + unit]) * i64::from(self.hidden[unit]))
            .sum()
    }

    fn observe_head_scalar(&mut self, start: usize, error: i32) {
        for unit in 0..WIDTH {
            self.gradient_hidden[unit] += round(
                i64::from(error) * i64::from(self.weights[start + unit]),
                HEAD_GRADIENT_SHIFT,
            );
            let update = round(
                i64::from(error) * i64::from(self.hidden[unit]),
                FRACTION_BITS + UPDATE_SHIFT,
            );
            self.weights[start + unit] =
                (self.weights[start + unit] + update).clamp(-HEAD_LIMIT, HEAD_LIMIT);
        }
    }

    #[inline(never)]
    pub(in crate::core::cm) fn finish_byte(&mut self) {
        debug_assert_eq!(self.observed_bits, 8);
        #[cfg(target_arch = "x86_64")]
        if self.dispatch == Dispatch::Native {
            // SAFETY: each kernel runs only after its features are detected at
            // runtime; both access fixed-size model arrays and reproduce the
            // scalar arithmetic exactly.
            if std::is_x86_feature_detected!("avx512f") {
                unsafe { self.finish_byte_avx512() };
                return;
            }
            if std::is_x86_feature_detected!("avx2") {
                unsafe { self.finish_byte_avx2() };
                return;
            }
        }
        self.finish_byte_scalar();
    }

    fn finish_byte_scalar(&mut self) {
        // Truncated online backpropagation through at most four already
        // observed transitions. Accumulate updates before changing weights.
        // Forward traces precede this byte's target; none contains future data.
        let mut hidden_gradient = self.gradient_hidden;
        let mut future_cell_gradient = [0; WIDTH];
        let mut recurrent_updates = [[0i32; WIDTH]; ROWS];
        let mut bias_updates = [0i32; ROWS];
        let mut embedding_updates = [[0i32; ROWS]; STEPS];
        for (step, embedding_update) in embedding_updates
            .iter_mut()
            .enumerate()
            .take(self.trace_count)
        {
            let index = (self.trace_position + STEPS - 1 - step) % STEPS;
            let trace = self.traces[index];
            let mut previous_hidden_gradient = [0i32; WIDTH];
            let mut previous_cell_gradient = [0i32; WIDTH];
            for unit in 0..WIDTH {
                let gradient =
                    hidden_gradient[unit].clamp(-HIDDEN_GRADIENT_LIMIT, HIDDEN_GRADIENT_LIMIT);
                let output = trace.gates[3][unit];
                let input = trace.gates[1][unit];
                let forget = trace.gates[2][unit];
                let candidate = trace.gates[0][unit];
                let output_gradient = product(
                    product(gradient, trace.cell_tanh[unit]),
                    product(output, ONE - output),
                );
                let cell_gradient = if trace.cell_clipped[unit] {
                    0
                } else {
                    (product(
                        product(gradient, output),
                        ONE - product(trace.cell_tanh[unit], trace.cell_tanh[unit]),
                    ) + future_cell_gradient[unit])
